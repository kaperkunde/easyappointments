# App
BASE_URL=http://localhost:3000
PORT=3000
DEBUG_MODE=TRUE
APP_PORT=80

# Database (local override creates mysql; Coolify uses a shared instance)
DB_HOST=mysql
DB_NAME=easyappointments
DB_USERNAME=easyappointments
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# Coolify sets this automatically in production
# SERVICE_URL_EASYCALENDAR=https://calendar.example.com

# Startup migration (waits for DB, then runs pending migrations when installed)
# MIGRATE_DB_WAIT_ATTEMPTS=60
# MIGRATE_DB_WAIT_SECONDS=2

# Mail (optional for local testing)
MAIL_SMTP_HOST=
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Easy!Appointments
MAIL_REPLY_TO_ADDRESS=
